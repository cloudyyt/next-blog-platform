# ===========================================
# 环境变量示例（复制为 .env 后填入真值）
# 复制命令：cp .env.example .env
# ===========================================

# ---------- 数据库（PostgreSQL）----------
# 本地开发用 Docker 起的 postgres（127.0.0.1:5432，库名 blog_platform）
# schema.prisma 的 datasource 读的是 PRISMA_DATABASE_URL
PRISMA_DATABASE_URL="postgresql://用户名:密码@127.0.0.1:5432/blog_platform?schema=public"
# DATABASE_URL 给 db:seed 等脚本用（与上面同一个库即可）
DATABASE_URL="postgresql://用户名:密码@127.0.0.1:5432/blog_platform?schema=public"

# ---------- 认证 ----------
# JWT 密钥，生产务必用强随机串（≥32 字符）
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-secret-key-change-in-production"

# ---------- 站点 ----------
# 站点根 URL（生产填你的域名，如 https://your-blog.com）
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# 评论/搜索 IP 哈希盐值（任意随机串）
IP_HASH_SALT="any-random-string"

# ---------- 阿里云 OSS（图片上传，可选）----------
# 不接 OSS 时留空即可，见 docs/0725-oss-接入调研与接入草案.md
OSS_REGION="oss-cn-guangzhou"
OSS_BUCKET="your-bucket-name"
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
# 服务器（ECS）部署时设 true，走内网 endpoint 免流量费；本地开发留空
OSS_USE_INTERNAL=""
