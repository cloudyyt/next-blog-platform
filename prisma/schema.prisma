// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

// 用户模型
model User {
  id        String   @id @default(cuid())
  name      String   @unique // 昵称，唯一（不可改）
  password  String
  avatar    String?  // 头像 OSS URL（可选，无则前端用首字母占位）
  bio       String?  // 个人简介（可选）
  role      String   @default("user") // user, admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts     Post[]
  comments  Comment[]
  guideChapters GuideChapter[]

  @@map("users")
}

// 文章模型
model Post {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  content     String
  excerpt     String?
  coverImage  String?
  published   Boolean    @default(false)
  encrypted   Boolean    @default(false) // 加密文章：详情页需输入密码(env DAILY_SECRET)才可阅读
  viewCount   Int        @default(0)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  categories Category[]
  tags       Tag[]
  comments   Comment[]
  views      PostViewEvent[]
  
  @@map("posts")
}

model PostViewEvent {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  ipHash  String
  uaHash  String?
  referer String?
  path    String?

  @@index([postId, createdAt])
  @@index([createdAt])
  @@map("post_view_events")
}

// 分类模型
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  posts      Post[]
  
  @@map("categories")
}

// 标签模型
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  posts     Post[]
  
  @@map("tags")
}

// 评论模型
model Comment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?  // 父评论ID，用于回复功能
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("comments")
}

// Agent 指南章节（独立于 Post 的内容类型）
model GuideChapter {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String                          // markdown 正文
  description String?
  group       String                          // intro|foundation|core|system|appendix
  difficulty  String                          // 入门|进阶|实战
  order       Int      @default(10)           // 分组内排序权重
  readingTime Int?                            // 留空则前端按正文估算
  comingSoon  Boolean  @default(false)
  published   Boolean  @default(false)
  ogImage     String?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([group, order])
  @@index([published])
  @@map("guide_chapters")
}

// Agent 指南系列配置（singleton，整站一份）
model GuideSeriesConfig {
  id            String   @id @default("singleton") // 固定 id，配合 upsert 实现单例
  title         String
  subtitle      String?
  coverImage    String?
  badge         String   @default("连载中")
  cta           String?
  valueCard1    String?
  valueCard2    String?
  valueCard4    String?
  ogTitle       String?
  ogDescription String?
  ogImage       String?
  groups        Json                            // GuideGroupMeta[]（5 阶段 label/hint/icon/order）
  updatedAt     DateTime @updatedAt

  @@map("guide_series_config")
}

// 碎碎念（关于页时间线，短句/情绪记录）
// 个人单站，不记作者。
model Thought {
  id        String   @id @default(cuid())
  content   String
  weather   String?  // WeatherKey（rain/cloud/sunny/...），渲染层映射图标
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt(sort: Desc)])
  @@map("thoughts")
}

// 关于页配置（singleton，整站一份）
// 头像/名字仍走 User 表，这里只管关于页专属文案。
model AboutConfig {
  id        String   @id @default("singleton")
  tagline   String?  // 作者一句话
  intro     String?  // 关于我文案（纯文本，按空行分段）
  updatedAt DateTime @updatedAt

  @@map("about_config")
}

